{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/lib/constants.ts",
    "src/lib/imageValidation.ts",
    "src/lib/plantIdentification.ts",
    "src/lib/plantNormalization.ts",
    "src/lib/safePlants.ts",
    "src/lib/toxicityApi.ts",
    "src/types/plant.ts",
    "src/app/api/analyze/route.ts",
    "src/app/api/identify/route.ts",
    "src/app/api/toxicity/route.ts",
    "src/data/safePlants.json",
    "tests/**/*.ts"
  ]
}
